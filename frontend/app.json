{
  "expo": {
    "name": "Mayoreo",
    "slug": "frontend",
    "scheme": "mayoreo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE5E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mayoreo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#B4232D",
          "defaultChannel": "price-changes-v2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mayoreo necesita acceso a tus fotos para agregar imágenes a los productos.",
          "cameraPermission": "Mayoreo necesita acceso a la cámara para tomar fotos de productos y escanear códigos de barras.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mayoreo necesita acceso a la cámara para tomar fotos de productos y escanear códigos de barras.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Mayoreo necesita permiso para guardar el código QR de asistencia en tus fotos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      "expo-font"
    ]
  }
}
